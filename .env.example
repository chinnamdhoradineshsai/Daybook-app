# Daybook Configuration Example
# Copy this file to .env and fill in your values

# Flask Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-change-this-for-production

# Development Server Settings
PORT=5000
HOST=0.0.0.0

# Supabase & PostgreSQL (Phase 3 & 4)
# You will get these from your Supabase dashboard (Project Settings -> API & Database)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-key
DATABASE_URL=postgresql://postgres.your-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres
